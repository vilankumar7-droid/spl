{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loan.application.updated v1",
  "description": "Topic: loan-application-events. Published when a draft is created, edited or a document is attached.",
  "allOf": [{ "$ref": "event-envelope.v1.schema.json" }],
  "properties": {
    "eventType": { "const": "loan.application.updated" },
    "data": {
      "type": "object",
      "required": ["change"],
      "properties": {
        "change": { "enum": ["CREATED", "DETAILS_UPDATED", "DOCUMENT_UPLOADED"] },
        "documentId": { "type": "string" },
        "documentType": { "type": "string" }
      }
    }
  }
}
