# Copy to .env and change the values. Never commit .env.
POSTGRES_DB=personal_loan
POSTGRES_USER=studentloan
POSTGRES_PASSWORD=change-me-local-only

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TOKEN_MINUTES=60

# Synthetic demo accounts (student/reviewer/admin @demo.local)
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=Password@123

# Feature toggles (enforced by the backend)
FEATURE_HOME_LOAN=false
FEATURE_PDF_AGENT=false
FEATURE_KAFKA=false
FEATURE_BACKGROUND_VERIFICATION=false
